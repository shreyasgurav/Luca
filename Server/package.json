{
  "name": "luca-server",
  "version": "1.0.0",
  "description": "Luca AI Assistant Server - Production Ready",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/integration.test.js",
    "test:load": "jest tests/load.test.js --timeout=120000",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "security": "npm audit && npm audit --audit-level=moderate",
    "build": "echo 'No build step required for Node.js server'",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "docker:build": "docker build -f Dockerfile.prod -t luca-server:latest .",
    "docker:run": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.prod.yml down"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "node-fetch": "^2.6.7",
    "redis": "^4.6.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@sentry/node": "^7.80.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "optionalDependencies": {
    "@sentry/node": "^7.80.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "ai",
    "assistant",
    "openai",
    "api",
    "production"
  ],
  "author": "Luca Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/luca.git"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!jest.config.js",
      "!config/**"
    ],
    "testTimeout": 30000,
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error",
      "no-var": "error",
      "eqeqeq": "error"
    }
  }
}