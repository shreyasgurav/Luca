rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null; }
    function isOwner(userId) { return isAuthed() && request.auth.uid == userId; }

    // users
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // messages
    match /messages/{messageId} {
      // Read: only own docs
      allow read: if isOwner(resource.data.userId);

      // Create: only self (simplified - no timestamp validation for now)
      allow create: if isOwner(request.resource.data.userId);

      // Update: only self
      allow update: if isOwner(resource.data.userId);

      // Delete: only self
      allow delete: if isOwner(resource.data.userId);
    }

    // memories (legacy)
    match /memories/{memoryId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // vector_memories (preferred)
    match /vector_memories/{memoryId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // sessions (chat sessions)
    match /sessions/{sessionId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // user_sessions (listen sessions)
    match /user_sessions/{sessionId} {
      // Parent doc must carry userId
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);

      // segments subcollection
      match /segments/{segmentId} {
        // Create allowed if segment embeds its own userId (avoids race on parent)
        allow create: if isOwner(request.resource.data.userId);

        // Read/Update/Delete by segment.userId OR parent's userId (covers legacy segments)
        allow read, update, delete: if isOwner(resource.data.userId)
          || isOwner(get(/databases/$(database)/documents/user_sessions/$(sessionId)).data.userId);
      }
    }

    // custom_datasets (knowledge base datasets)
    match /custom_datasets/{datasetId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }
  }
}


